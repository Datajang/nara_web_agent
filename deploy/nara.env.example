# /etc/nara/nara.env 틀 (SPEC 부록 A, §11.2). root:nara 0640. 비밀값은 서버에서만 채운다.
# 빈 값(=뒤가 비어 있음)은 반드시 채운다. 생성: SECRET_KEY는 `openssl rand -hex 32`.
ENV=production
LOG_FORMAT=json

# DB: PostgreSQL 16 (PGDG), 5434 포트. 5432는 시스템 PG13, 5433은 개발 Docker가 쓴다.
DATABASE_URL=postgresql+asyncpg://nara:CHANGE_ME_DB_PASSWORD@127.0.0.1:5434/nara

# 인증 (§9.7)
SECRET_KEY=
# APP_ORIGIN은 deploy/set-host.sh가 접속 주소로 바꾼다(도메인 전에는 <IP를 -로>.sslip.io)
APP_ORIGIN=https://nara.example.com
COOKIE_SECURE=true
ALLOWED_EMAIL_DOMAINS=
REQUIRE_ADMIN_APPROVAL=true
# 이 도메인(쉼표 구분)은 메일 인증만으로 바로 사용, 그 밖의 주소는 관리자 승인 후 사용
AUTO_APPROVE_EMAIL_DOMAINS=

# 메일 (§9.2-8). 운영은 smtp만 허용
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# G2B (§5.2). v1 .env에서 이 두 값만 옮긴다(docs/ops/CUTOVER.md)
NARA_API_KEY=
NARA_PRESPEC_API_KEY=
# 운영계정(API마다 하루 10만, 2026-11-24) 기준. 개발계정이면 1000/300/100/300
# (docs/decisions/2026-11-24-g2b-operating-quota.md)
G2B_DAILY_CALL_BUDGET=150000
# 낙찰·계약(§15): 비우면 NARA_API_KEY를 쓴다. 낙찰 몫 하루 예산
NARA_AWARD_API_KEY=
G2B_AWARDS_DAILY_BUDGET=15000
# 계약정보(공동수급) 백필 한 번 실행의 호출 상한. 나머지 낙찰 몫은 공고 '경쟁 구도' 온디맨드에 남긴다
G2B_CONTRACTS_BACKFILL_CALLS=3000
# 개찰 결과 자동 수집(우리 투찰 결과, P12) 하루 몫. 낙찰 몫과 따로 센다.
# 낙찰·개찰은 같은 낙찰정보서비스라 '낙찰 몫 + 개찰 몫'이 그 서비스 한도(10만)를 넘지 않게
G2B_OPENINGS_DAILY_BUDGET=80000
# 북마크 공고 결과 메일 감시(5분 타이머) 하루 몫. 같은 낙찰정보서비스라 위 두 몫과 합쳐 10만 아래로
G2B_RESULT_WATCH_DAILY_BUDGET=3000
G2B_FILE_HOST_ALLOWLIST=www.g2b.go.kr
# v1 nara-api 유닛은 G2B 접속에 HTTPS_PROXY를 썼다. v2에서도 필요하면 같은 값을 넣는다.
#HTTPS_PROXY=

# LLM (§8.2, docs/LLM_SETUP.md). LLM_API_KEY는 /etc/nara/vllm.env의 VLLM_API_KEY와 같아야 한다
LLM_BACKEND=vllm
LLM_BASE_URL=http://127.0.0.1:8011/v1
LLM_MODEL=brain
LLM_MODEL_ID=q35-9b
LLM_API_KEY=

# 경보 (§11.7). 비우면 메일 없이 로그만 남는다
ALERT_EMAIL=

# 백업 외부 보관 (§11.5 [가정]). 버킷을 정하면 gs://<버킷>/nara 형태로
#BACKUP_GCS_URI=
