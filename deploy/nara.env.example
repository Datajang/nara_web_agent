# /etc/nara/nara.env 틀 (SPEC 부록 A, §11.2). root:nara 0640. 비밀값은 서버에서만 채운다.
# 빈 값(=뒤가 비어 있음)은 반드시 채운다. 생성: SECRET_KEY는 `openssl rand -hex 32`.
ENV=production
LOG_FORMAT=json

# DB: PostgreSQL 16 (PGDG), 5434 포트. 5432는 시스템 PG13, 5433은 개발 Docker가 쓴다.
DATABASE_URL=postgresql+asyncpg://nara:CHANGE_ME_DB_PASSWORD@127.0.0.1:5434/nara

# 인증 (§9.7)
SECRET_KEY=
# APP_ORIGIN은 deploy/set-host.sh가 접속 주소로 바꾼다(도메인 전에는 <IP를 -로>.sslip.io)
APP_ORIGIN=https://nara.example.com
COOKIE_SECURE=true
ALLOWED_EMAIL_DOMAINS=
REQUIRE_ADMIN_APPROVAL=true

# 메일 (§9.2-8). 운영은 smtp만 허용
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# G2B (§5.2). v1 .env에서 이 두 값만 옮긴다(docs/ops/CUTOVER.md)
NARA_API_KEY=
NARA_PRESPEC_API_KEY=
G2B_DAILY_CALL_BUDGET=1000
G2B_FILE_HOST_ALLOWLIST=www.g2b.go.kr
# v1 nara-api 유닛은 G2B 접속에 HTTPS_PROXY를 썼다. v2에서도 필요하면 같은 값을 넣는다.
#HTTPS_PROXY=

# LLM (§8.2, docs/LLM_SETUP.md). LLM_API_KEY는 /etc/nara/vllm.env의 VLLM_API_KEY와 같아야 한다
LLM_BACKEND=vllm
LLM_BASE_URL=http://127.0.0.1:8011/v1
LLM_MODEL=brain
LLM_MODEL_ID=q35-9b
LLM_API_KEY=

# 경보 (§11.7). 비우면 메일 없이 로그만 남는다
ALERT_EMAIL=

# 백업 외부 보관 (§11.5 [가정]). 버킷을 정하면 gs://<버킷>/nara 형태로
#BACKUP_GCS_URI=
