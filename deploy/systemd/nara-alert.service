# 운영 경보 점검 (SPEC §11.7). 경보가 있으면 종료 코드 1, ALERT_EMAIL로 메일.
[Unit]
Description=nara alert check
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=nara
WorkingDirectory=/opt/nara/app/backend
EnvironmentFile=/etc/nara/nara.env
Environment=TMPDIR=/var/lib/nara/tmp
Environment=HOME=/var/lib/nara
ExecStart=/opt/nara/venv/bin/python -m app.ops.check --readyz-url http://127.0.0.1:8010/readyz --state /var/lib/nara/alert-state.json --disk / --disk /var/backups/nara
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nara
