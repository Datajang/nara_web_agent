# 수집기 1회 실행 (SPEC §11.3). nara-collector.timer가 부른다.
[Unit]
Description=nara collector (incremental)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=nara
WorkingDirectory=/opt/nara/app/backend
EnvironmentFile=/etc/nara/nara.env
Environment=TMPDIR=/var/lib/nara/tmp
Environment=HOME=/var/lib/nara
ExecStart=/opt/nara/venv/bin/python -m app.collector incremental
TimeoutStartSec=900
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nara
