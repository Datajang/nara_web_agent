          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "admin"
            ],
            "title": "Role"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_verification",
              "pending_approval",
              "active",
              "disabled"
            ],
            "title": "Status"
          },
          "email_verified_at": {
